---
interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
}
const { title, description, lastUpdated } = Astro.props;
---
<main class="legal" id="main-content">
  <header>
    <h1 class="headline">{title}</h1>
    {description && <p>{description}</p>}
    {lastUpdated && <p>Last updated: {lastUpdated}</p>}
  </header>
  <div class="legal-content"><slot /></div>
  <a href="/" class="link-arrow mt-9">← Back to home</a>
</main>

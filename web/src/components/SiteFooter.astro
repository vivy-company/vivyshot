---
import { Icon } from "astro-icon/components";
import { SITE, translations, languageOptions } from "../lib/site";
import { getLanguage, homePath } from "../i18n/utils";
const language = getLanguage(Astro.url);
const t = translations[language];
const home = homePath(language);
const isHome = Astro.url.pathname === home;
const activeLanguage = languageOptions.find(({code}) => code === language)!;
---
<footer class="site-footer border-t border-line bg-black text-[12px] leading-5 text-faint">
  <div class="container-wide py-10">
    <div class="border-b border-line pb-6">
      <p class="max-w-3xl">{t.home.requirements}</p>
    </div>
    <div class="grid gap-8 pt-8 sm:grid-cols-3">
      <div>
        <p class="font-semibold text-ink">{t.footer.productTitle}</p>
        <nav class="mt-3 grid gap-1 sm:gap-2.5" aria-label={t.footer.productTitle}>
          <a href={`${home}#features`} class="w-fit transition hover:text-ink">{t.footer.navFeatures}</a>
          <a href={`${home}#pricing`} class="w-fit transition hover:text-ink">{t.footer.navPricing}</a>
          <a href={`${home}#roadmap`} class="w-fit transition hover:text-ink">{t.roadmap.title}</a>
          <a href={SITE.appStoreUrl} class="w-fit transition hover:text-ink">{t.pricing.free.cta}</a>
        </nav>
      </div>
      <div>
        <p class="font-semibold text-ink">{t.footer.resourcesTitle}</p>
        <nav class="mt-3 grid gap-1 sm:gap-2.5" aria-label={t.footer.resourcesTitle}>
          <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="w-fit transition hover:text-ink">GitHub</a>
          <a href="mailto:vivyshot@vivy.company" class="w-fit transition hover:text-ink">vivyshot@vivy.company</a>
        </nav>
      </div>
      <div>
        <p class="font-semibold text-ink">VivyShot</p>
        <p class="mt-3 max-w-xs">{t.footer.description}</p>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} <span>{t.footer.copyright}</span></p>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/privacy" class="transition hover:text-ink">{t.footer.privacy}</a>
        <a href="/terms" class="transition hover:text-ink">{t.footer.terms}</a>
        <a href="/refund" class="transition hover:text-ink">{t.footer.refunds}</a>
        {isHome && <details class="group relative w-full sm:w-auto">
          <summary class="flex cursor-pointer list-none items-center min-h-11 gap-1.5 py-2 text-faint hover:text-ink [&::-webkit-details-marker]:hidden" aria-label={t.nav.language}>
            <Icon name="lucide:globe" class="size-3.5" />
            <span>{activeLanguage.label}</span>
            <Icon name="lucide:chevron-down" class="size-3 transition group-open:rotate-180" />
          </summary>
          <nav aria-label={t.nav.language} class="absolute bottom-full left-0 sm:left-auto sm:right-0 z-20 mb-2 grid max-h-72 w-44 gap-0.5 overflow-y-auto rounded-xl border border-line bg-surface p-1.5 shadow-xl">
            {languageOptions.map(({code, label, htmlLang}) => <a href={homePath(code)} lang={htmlLang} hreflang={htmlLang} aria-current={code === language ? "page" : undefined} class:list={["rounded-lg px-3 py-1.5 hover:bg-surface-hover hover:text-ink", { "bg-surface-hover text-ink": code === language }]}>{label}</a>)}
          </nav>
        </details>}
      </div>
    </div>
  </div>
</footer>
